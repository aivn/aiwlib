		class Iterator{
			friend class BitMask;
			const uint64_t *p = nullptr; uint64_t w = 0; int pos = N;
		public:
			int operator * () const { return pos; }
			bool operator != (Iterator) const { return pos<N; }
			void operator ++ (){  // это можно оптимизировать
				while(!w && pos<N){ w = *++p; pos = (pos&~63)+64; }
				if(w){  pos = (pos&~63) + __builtin_ctzl(w); w ^= uint64_t(1)<<(pos&63); }
			}
		};
		Iterator begin() const {  // это можно оптимизировать
			Iterator I; I.p = p; I.pos = 0; I.w = p[0];
			while(!I.w && I.pos<N){ I.w = *++I.p; I.pos += 64; }
			if(I.w){  I.pos += __builtin_ctzl(I.w); I.w ^= uint64_t(1)<<(I.pos&63); }
			return I;
		}
		Iterator end() const { return Iterator(); }
		// __builtin_ffsl (unsigned long x)
		// Возвращает единицу плюс индекс младшего значащего 1 бита x, или, если x равно нулю, возвращает ноль. 

		BitMask& operator |= (const BitMask &other){
			for(int i=0; i<sz; i++) p[i] |= other.p[i];
			count = size0();
			return *this;
		}
		BitMask& operator &= (const BitMask &other){
			for(int i=0; i<sz; i++) p[i] &= other.p[i];
			count = size0(); 
			return *this;
		}
		// bool chunk(int i, uint64_t mask, bool on) const { return ((p[i/64]>>(i%64))&mask)==mask*on; }
		bool check_chunk(const int D, int i, bool on=true) const { uint64_t m = (~uint64_t(0))>>(64-(1<<D));  return ((p[i/64]>>(i%64))&m)==m*on; }
		uint64_t get_chunk(const int D, int i) const { uint64_t m = (~uint64_t(0))>>(64-(1<<D));  return (p[i/64]>>(i%64))&m; }
		void set_chunk(const int D, int i){ uint64_t m = (~uint64_t(0))>>(64-(1<<D));  p[i/64] |= m<<(i%64); }
		
		int uid(int i) const {  ///< возвращает число ненулевых битов до i-й позиции
			int r = 0, k = 0; for(int n=i/64; k<n; k++) r += __builtin_popcountl(p[k]);
			return  r+__builtin_popcountl(p[k]&(~uint64_t(0)>>(64-i%64)));
		}
