	struct BitMask64{
		uint64_t data = 0;

		int size() const { return __builtin_popcountl(data); }
		bool operator [](int i) const { return data&(uint64_t(1)<<i); }
		void set(int i, bool x=true){  uint64_t m = uint64_t(1)<<i; if(x) data |=  m; else data &= ~m; }
		void fill(int N){ data = ~uint64_t(0)>>64-N; }
		int uid(int i) const { return  __builtin_popcountl(data&(~uint64_t(0)>>(64-i))); }  ///< возвращает число ненулевых битов до i-й позиции
		int min() const { return __builtin_ctzl(data); }
		int max() const { return 63-__builtin_clzl(data); }
		
		class Iterator{
			uint64_t data; int pos;
		public:
			Iterator(): data(0), pos(64) {}
			Iterator(uint64_t data_): data(data_){ pos = __builtin_ctzl(data); }
			int operator *() const { return pos; }
			bool operator == (const Iterator &other) const { return data==other.data; }
			bool operator != (const Iterator &other) const { return data!=other.data; }
			Iterator& operator ++ (){ data &= ~(uint64_t(1)<<pos); pos = __builtin_ctzl(data);	return *this; }
			Iterator operator ++ (int){ Iterator I = *this; ++*this; return I; }
		};
		Iterator begin() const { return Iterator(data); }
		Iterator end() const { return Iterator(); }
	};
