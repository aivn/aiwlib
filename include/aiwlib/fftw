	//--------------------------------------------------------------------------
	//  1D fftw3 plans for float and double
	//--------------------------------------------------------------------------
	template <typename T> class FFTW1D{
		typedef fftw3_t<T> fftw3;
		T *rbuf = nullptr;
		typename fftw3::complex *cbuf = nullptr;
		typename fftw3::plan plan_fwd, plan_bwd;
		int sz = 0; bool r2c = false;
	public:
		void init(int sz_, bool r2c_){
			sz = sz_;  r2c = r2c_;
			if(rbuf) fftw3::free(rbuf);
			if(cbuf){ fftw3::free(cbuf); fftw3::destroy_plan(plan_fwd); fftw3::destroy_plan(plan_bwd); }
			if(r2c){
				rbuf = (T*) fftw3::malloc(sizeof(T)*sz);
				cbuf = (typename fftw3::complex*) fftw3::malloc(sizeof(typename fftw3::complex)*(sz/2+1));
				plan_fwd = fftw3::plan_r2c(sz, rbuf, cbuf, FFTW_ESTIMATE);
				plan_bwd = fftw3::plan_c2r(sz, cbuf, rbuf, FFTW_ESTIMATE);
			} else {
				rbuf = nullptr;
				cbuf = (typename fftw3::complex*) fftw3::malloc(sizeof(typename fftw3::complex)*sz);
				plan_fwd = fftw3::plan_1d(sz, cbuf, cbuf, FFTW_FORWARD, FFTW_ESTIMATE);
				plan_bwd = fftw3::plan_1d(sz, cbuf, cbuf, FFTW_BACKWARD, FFTW_ESTIMATE);
			}
		}
		FFTW1D(){}
		FFTW1D(const FFTW1D& other){ init(other.sz, other.r2c); }
		~FFTW1D(){
			if(rbuf) fftw3::free(rbuf);
			if(cbuf){ fftw3::free(cbuf); fftw3::destroy_plan(plan_fwd); fftw3::destroy_plan(plan_bwd); }
		}

		T& r(int i){ /*if(!r2c || i<0 || i>=sz){ WMSG(r2c, i, sz); abort(); }*/ return rbuf[i]; }
		typename fftw3::complex& c(int i){ /*if(i<0 || i>=sz){ WMSG(r2c, i, sz); abort(); }*/ return cbuf[i]; }

		void fwd(){ fftw3::execute(plan_fwd); }
		void bwd(){ fftw3::execute(plan_bwd); }		
	};
	//--------------------------------------------------------------------------
	//   Final wrapper
	//--------------------------------------------------------------------------
	template <int D, typename T> class FFTW{
		std::vector<std::complex<T> > data;
		int csz = 0, zsz0 = 0, Nth = 0; Ind<D> box;  Vec<D, uint64_t>  mul;
		T* real_buf = nullptr;
		std::vector<FFTW1D<T> > plans;
		Vecf<D> step, _step, fstep;
		size_t data_size; 
	public:
		size_t size() const { return data_size; }		
		const Ind<D>& bbox() const { return box; }
		
		FFTW(){}
		void init(const Ind<D> &box_, int csz_, Vecf<D> step_=Vecf<D>(1.f)){
			box = box_;  zsz0 = box[D-1];  box[D-1] = box[D-1]/2+1; csz = csz_;
			data.resize(prod(box)*csz);
			mul[0] = csz; for(int i=0; i<D-1; i++) mul[i+1] = mul[i]*box[i];  // традиционное следование осей (x самая быстрая)
			Nth = omp_get_max_threads();   plans.resize(Nth*D);
			for(int ith=0; ith<Nth; ith++) for(int d=0; d<D; d++) plans[ith*D+d].init(box_[d], d==D-1); 
			step = step_; _step = 1.f/step; fstep = 1.f/(step&box); fstep[D-1] = 1.f/(step[D-1]*zsz0);
			data_size = data.size()/csz;
		}
		FFTW(const Ind<D> &box_, int csz_, Vecf<D> step_=Vecf<D>(1.f)){ init(box_, csz_, step_); }

		std::complex<T>* operator [](size_t i){ return &data[i*csz]; }
		const std::complex<T>* operator [](size_t i) const { return data.data()+i*csz; }		
		float get_nu(int axis, int nui) const { return fstep[axis]*(axis==D-1 || nui<=box[axis]/2 ? nui: box[axis]-nui); }
		Vecf<D> get_nu(const Ind<D> &nui) const {  Vecf<D> nu; for(int i=0; i<D; i++){ nu[i] = get_nu(i, nui[i]); }  return nu; } 
		//----------------------------------------------------------------------
		template <typename FGET> double fwd(FGET fget){  // fget(const Ind<D> &pos, int id) ==> T x,  return runtime
			double t_start = omp_get_wtime();
			for(int d=D-1; d>=0; d--){  // цикл по направлениям
				Ind<D> dbox = box;  dbox[d] = 1;  size_t dsz = prod(dbox);  // WMSG(d, dbox, dsz);
#pragma omp parallel for
				for(size_t wid=0; wid<dsz; wid++){  // цикл по 1d линиями
					int thID = omp_get_thread_num();  FFTW1D<T>& plan = plans[thID*D+d];
					Ind<D> pos = wid%dbox;  size_t off = mul*pos;  // if(pos[d]){ WMSG(d, pos); abort(); }  
					for(int c=0; c<csz; c++){  // цикл по компонентам
						if(d==D-1) for(int i=0, sz=zsz0; i<sz; i++){ pos[D-1] = i; plan.r(i) = fget(pos, c); }
						else for(int i=0, sz=box[d]; i<sz; i++){ auto x = data[off+i*mul[d]+c];  plan.c(i)[0] = x.real();  plan.c(i)[1] = x.imag(); }
						plan.fwd();
						for(int i=0, sz=box[d]; i<sz; i++){ auto &x = data[off+i*mul[d]+c];  x.real(plan.c(i)[0]);  x.imag(plan.c(i)[1]); }						
					}  // конец цикла по компонентам
				}  // конец цикла по 1d линиям
			}  // конец цикла по направлениям
			return omp_get_wtime()-t_start;
		}
		//----------------------------------------------------------------------
		template <typename FSET> double bwd(FSET fset){  // fset(const Ind<D> &pos, int id, T x),  return runtime
			double t_start = omp_get_wtime();
			T norm = double(box[D-1])/prod(box)/zsz0;
			for(int d=0; d<D; d++){  // цикл по направлениям
				Ind<D> dbox = box;  dbox[d] = 1; 	size_t dsz = prod(dbox);  
#pragma omp parallel for
				for(size_t wid=0; wid<dsz; wid++){  // цикл по 1d линиями
					int thID = omp_get_thread_num();  FFTW1D<T>& plan = plans[thID*D+d];
					Ind<D> pos = wid%dbox;  size_t off = mul*pos;   
					for(int c=0; c<csz; c++){  // цикл по компонентам
						for(int i=0, sz=box[d]; i<sz; i++){ auto x = data[off+i*mul[d]+c];  plan.c(i)[0] = x.real();  plan.c(i)[1] = x.imag(); }
						plan.bwd();
						if(d==D-1) for(int i=0, sz=zsz0; i<sz; i++){ pos[D-1] = i; fset(pos, c, plan.r(i)*norm); }						
						else for(int i=0, sz=box[d]; i<sz; i++){ auto &x = data[off+i*mul[d]+c];  x.real(plan.c(i)[0]);  x.imag(plan.c(i)[1]); }						
					}  // конец цикла по компонентам
				}  // конец цикла по 1d линиям
			}  // конец цикла по направлениям
			return omp_get_wtime()-t_start;
		}
		//----------------------------------------------------------------------
		template <typename Func> double for_each(Func func) const {  // func(const std::complex<T> *p, const Ind<D> &pos, T _norm),  return runtime
			double t_start = omp_get_wtime();
			T _norm = 2./zsz0;  for(int i=0; i<D-1; i++) _norm *= 2./box[i]; // ??? а если не степени двойки ???
			Ind<D> lim = box/2;  lim[D-1] = box[D-1]-1;  BoxIter<D> biter(box);
			for(size_t off=0, sz=biter.size(); off<sz; off++){
				biter(off); Ind<D> F = *biter; for(int i=0; i<D-1; i++) if(F[i]>lim[i]) F[i] = box[i]-F[i];  // ??? как отмечать отрицательные значения частот ???
				func(data.data()+off*csz, F, _norm);
			}
			return omp_get_wtime()-t_start;
		}
		//----------------------------------------------------------------------
		// fget(const std::complex<T> p[csz], size_t N) ==> Vec<D2, T2>
		template <int D2, typename T2, typename S, typename FGET>
		double dump(S &&fout, FGET fget, std::vector<std::string> axis={}, bool shift_zero=true) const {  // return runtime
			double t_start = omp_get_wtime();
			BinaryHead bh; bh.dim = D; bh.type = aiw::BinaryHead::mesh;  bh.szT = sizeof(T2)*D2; 
			for(int i=0; i<D; i++) bh.bbox[i] = box[i];
			for(int i=0, sz=std::min(D, int(axis.size())); i<sz; i++) bh.axis[i] = axis[i];
			if(shift_zero){
				for(int i=0; i<D-1; i++){  bh.bmin[i] = (-box[i]/2+1)/step[i]/box[i];  bh.bmax[i] = (box[i]/2+1)/step[i]/box[i]; }
				bh.bmin[D-1] = 0;  bh.bmax[D-1] = .5f/step[D-1];
			} else for(int i=0; i<D; i++){  bh.bmin[i] = 0;  bh.bmax[i] = box[i]; }
			bh.dump(fout);

			size_t N = prod(box)/box[D-1]*zsz0;
			if(shift_zero){
				Ind<D> a = -box/2+ind(1), b = box/2+ind(1); a[D-1] = 0; b[D-1] = box[D-1];
				for(Ind<D> p: irange(a, b)){
					Ind<D> pos; for(int i=0; i<D-1; i++) pos[i] = p[i]<0? box[i]+p[i]: p[i];
					pos[D-1] = p[D-1];  Vec<D2, T2> v = fget(data.data()+pos*mul, N);  fout.write((const char*)&v, sizeof(v)); 
				}
			} else for(Ind<D> pos: irange(box)){  Vec<D2, T2> v = fget(data.data()+pos*mul, N);  fout.write((const char*)&v, sizeof(v));  }
			return omp_get_wtime()-t_start;
		}
		template <int D2, typename T2, typename S, typename FGET>
		double dump(S &fout, FGET fget, std::vector<std::string> axis={}, bool shift_zero=true) const { return dump(std::move(fout), fget, axis, shift_zero); }
		//----------------------------------------------------------------------
		struct spectr_t{
			double l_av=0;     ///< средняя длина волны 
			double nu_av=0;    ///< средняя частота
			double nu2_av=0;   ///< средний квадрат частоты
			T ampl_max=0;      ///< максимум амплитуды в FFTW::data
			size_t off_max=0;  ///< смещение в FFTW::data отвечающее максимуму амплитуды
			Vecf<D> k_max;     ///< волновой вектор отвечающий максимуму амплитуды в FFTW::data
			int i_max=0;       ///< позиция в spectr отвечающая максимуму амплитуды
			std::vector<Vec<3> > spectr;  ///< вектор {nu, fget(...), g}
			void operator += (const spectr_t& other){
				l_av += other.l_av;  nu_av += other.nu_av;  nu2_av += other.nu2_av;
				for(int i=0, sz=spectr.size(); i<sz; i++) spectr[i][1] += other.spectr[i][1];
			}
			void operator /= (int n){  l_av /= n;  nu_av /= n;  nu2_av /= n;  for(auto &v: spectr) v[1] /= n; }
		};
		//----------------------------------------------------------------------
		template <typename FGET> spectr_t spectr(FGET fget, int sz=0, float f_max=0) const {  ///< fget(std::complex<T> z[csz], size_t N) ==> double
			Ind<D> lim = box/2;  lim[D-1] = box[D-1]-1;  if(sz<=0) sz = 1+lim.abs();
			spectr_t res;  res.spectr.resize(sz);  if(f_max<=0) f_max = .5f*_step.abs();
			size_t N = prod(box)/box[D-1]*zsz0;  double norm = 0;
			res.spectr[0] = vec(0., double(fget(data.data(), N)), 1.); res.ampl_max = res.spectr[0][1];

			BoxIter<D> biter(box);  float _df = (sz-1)/f_max;  
			for(size_t off=1, data_sz=data.size()/csz; off<data_sz; off++){
				biter(off); Ind<D> F = *biter; for(int i=0; i<D-1; i++) if(F[i]>lim[i]) F[i] = box[i]-F[i];
				float nu = (F&fstep).abs();  int f = 1+::floorf(nu*_df);  double ampl = fget(data.data()+off*csz, N);
				if(res.ampl_max<ampl){ res.ampl_max = ampl;  res.off_max = off; }
				if(F[D-1]) ampl *= 2;
				norm += ampl; res.l_av += ampl/nu;  res.nu_av += nu*ampl;  res.nu2_av += nu*nu*ampl;
				if(f<sz){ res.spectr[f][1] += ampl;  res.spectr[f][2] += 1+bool(F[D-1]); }
			}
			_df = 1./_df;
			for(int i=1; i<sz; i++){
				res.spectr[i][0] = (i-.5)*_df;
				if(res.spectr[i][2]) res.spectr[i][1] /= res.spectr[i][2];
				if(res.spectr[i][1]>res.spectr[res.i_max][1]) res.i_max = i;
			}
			res.l_av /= norm;  res.nu_av /= norm; res.nu2_av /= norm;
			return res;
		}
