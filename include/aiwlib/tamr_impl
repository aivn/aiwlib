//------------------------------------------------------------------------------
//  инициализация
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based>
void TiledAdaptiveMesh<T, D, R, cell_based>::init(const Ind<D> &tbox_){
	static_assert(2<=D && D<=6 && 0<R && R*D<=22, "illegal TAMR template parameters");
	tbox = tbox_;  tmul[0] = 1; for(int i=1; i<D; i++) tmul[i] = tmul[i-1]*tbox[i-1];
	zbound = 64; for(int sz=tbox.prod(); sz; sz>>=1) zbound--;  // log2(sz)
	zmask = (uint64_t(1)<<zbound)-1;  rank_lim = (zbound-5)/D;
	if(rank_lim<0 || zbound<5){ WMSG("TAMR too large ", D, R, tbox, zbound, rank_lim);  abort(); }
	forest.clear();  stencils.clear();  tiles.clear();  rtiles.clear(); rtiles.resize(rank_lim+1);
	for(Ind<D> tpos: irange<D>(tbox)){ add_tile(tpos, 0).usage.fill(1); }
	for(ZCurve64<D> z(0, R); z; z.off++) coords[z.off] = *z;  // заполнение таблицы координат

	Ind<D> ml3(1);  for(int i=1; i<D; i++) ml3[i] = ml3[i-1]*3;  // заполнением bmask и gmask
	for(Ind<D> p: irange<D>(-1, 2)){  
		int f = (p+ind(1))*ml3; uint32_t &m = bmask[f];  m = 0;
		for(int i=0; i<D; i++) m |= ((p[i]<0)<<(2*i))|((p[i]>0)<<(2*i+1));
		if(p.prod()) gmask[f] = uint32_t(1)<<ZCurve32<D>((ind(1)-p)/2, 1).off;  // чистые маски на углах
	}  
	for(Ind<D> p: irange<D>(-1, 2)) if(!p.prod()){
			uint64_t &m = gmask[(p+ind(1))*ml3];  m = 0;
			Ind<D> up(1); for(int i=0; i<D; i++) up[i] += p[i]==0; 
			for(Ind<D> d: irange(up)) m |= gmask[(p+d*2+ind(1))*ml3];
		}
	steps.resize(rank_lim+1);  steps[0] = step; for(int i=1; i<=rank_lim; i++) steps[i] = steps[i-1]/2;
	int i = 0; for(const Ind<D> &p: irange<3>(-1, 2)) cube3Xtpos[i++] = p;
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> typename TiledAdaptiveMesh<T, D, R, cell_based>::tile_t&
TiledAdaptiveMesh<T, D, R, cell_based>::add_tile(const Ind<D> &tpos, const int rank){  // при необходимости добавляет тайл и встраивает его в струкутуру данных
	if(rank<0 || rank>rank_lim){ WMSG("incorrect rank ", rank, rank_lim); abort(); }  // ???
	uint64_t toff = tpos2toff(tpos, rank);  auto I = forest.find(toff);  if(I!=forest.end()) return I->second;  // поиск тайла в лесу
	tile_t &tile = forest[toff];  tile.toff = toff; tiles.push_back(&tile);  tile.tID = tiles.size()-1;  // размещение тайла в лесу и в общем массиве тайлов
	rtiles[rank].push_back(&tile);  tile.rtID = rtiles[rank].size()-1;     // размещение тайла в массиве тайлов по рангам
	while(toff&31){  // поиск родителя
		toff = up_toff(toff); I = forest.find(toff);
		if(I!=forest.end()){ tile.parent = &(I->second);  I->second.children |= uint64_t(1)<<((tile.toff>>(zbound-D*I->second.rank()-D))&dbits);  break; }
	}
	I = forest.find(tile.toff);  uint64_t ntoff = next_toff(tile.toff);  int shift = zbound-D*tile.rank()-D;
	while(++I!=forest.end() && I->first<ntoff){ tile.children |= uint64_t(1)<<((I->first>>shift)&dbits); if(!I->second.parent) I->second.parent = &tile;  }  // поиск потомков
	for(int i=0; i<D; i++){ int sz = tbox[i]<<rank, p = (tpos[i]+sz)%sz;  tile.bmask |= ((p==0)<<(2*i))|((p==sz-1)<<(2*i+1)); }  // расчет bmask
	profile.count[TAMR_pf::n_tadd]++;
	// for(auto &I: forest) if(I.second.parent && I.second.parent->rank()>=I.second.rank()){ WMSG(toff, tpos, I.first&31, toff2tpos(I.first), &I.second, I.second.parent, I.second.rank(), I.second.parent->rank()); abort(); }
	return tile;
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> void
TiledAdaptiveMesh<T, D, R, cell_based>::del_tile(int tID){
	tile_t *t = tiles[tID]; 
	if(t->children){  // если есть потомки, то надо им пофиксить parent-ов
		uint64_t ntoff = next_toff(t->toff);	
		for(auto I=forest.upper_bound(t->toff); I!=forest.end() && I->first<ntoff; ++I) if(I->second.parent==t) I->second.parent = t->parent; 
	} else	if(t->parent){  // если потомков нет, то надо пофиксить children у parent-а
		uint64_t m = uint64_t(1)<<((zbound-D*t->rank())&dbits);  t->parent->children &= ~m;
		if(t->rank()-t->parent->rank()>1){  // редкий и сложный случай, у t могут быть братья
			uint64_t toff = t->toff; do{ toff = up_toff(toff); } while((toff&31)>t->parent->rank()-1);	uint64_t ntoff = next_toff(t->toff);	
			for(auto I=forest.lower_bound(toff); I!=forest.end() && I->first<ntoff; ++I) if(I->first!=toff){ t->parent->children |= m; break; }
		}
	}
	if(tID<int(tiles.size()-1)){ tiles[tID] = tiles.back(); tiles[tID]->tID = tID; } tiles.pop_back();
	auto &rtls = rtiles[t->rank()]; int rtID = t->rtID;
	if(rtID<int(rtls.size()-1)){ rtls[rtID] = rtls.back(); rtls[rtID]->rtID = rtID; } rtls.pop_back();
	if(t->ghost_tID>=0){
		tID = t->ghost_tID; if(tID<int(ghost_tiles.size()-1)){ ghost_tiles[tID] = ghost_tiles.back(); ghost_tiles[tID].tile->ghost_tID = tID; }
		ghost_tiles.pop_back();
	}
	forest.erase(t->toff);  profile.count[TAMR_pf::n_tdel]++;  
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> void
TiledAdaptiveMesh<T, D, R, cell_based>::add_ghost(typename TiledAdaptiveMesh<T, D, R, cell_based>::tile_t *tile, int off){
	if(tile->ghost_tiD<0){ tile->ghost_tID = ghost_tiles.size(); ghost_tiles.emplace_back(); ghost_tiles.back().tile = tile; }
	ghost_tiles[tile->ghost_tID].usage.set(off);
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> int
TiledAdaptiveMesh<T, D, R, cell_based>::add_stencil(const std::vector<Ind<D> > &stencil){  ///< добавляет шаблон в таблицу stencil-ов, возвращает stencilID>0
	for(const Ind<D>& pos: stencil) if(!(-ind(1<<R)<=pos) || !(pos<=ind(1<<R))){ WMSG("incorrect stencil pos --- out of 1<<R ", pos, 1<<R); abort(); }
	stencils.emplace_back();  stencil_t &S = stencils.back();  S.stencil = stencil; S.nodes.reserve(S.stencil.size()<<R*D);  
	for(int itID=0; itID<(1<<R*D); itID++) for(int nID=0, sz=S.stencil.size(); nID<sz; nID++){
			Ind<D> pos = coords[itID]+S.stencil[nID]; stencil_node_t n; n.tID = 0;  int tmul = 1;
			for(int i=0; i<D; i++){
				if(pos[i]<0) pos[i] += 1<<R;               // попали в тайл слева
				else if(pos[i]<(1<<R)) n.tID += tmul;      // попали центральный тайл 
				else{ pos[i] -= 1<<R;  n.tID += 2*tmul; }  // попали в тайл справа
				tmul *= 3;  // формируем смещение в кубике 3х3х3... тайлов
			}
			n.off = ZCurve32<D>(pos, R).off;
			S.nodes.push_back(n);
			// WMSG(cID, stencil[nID],  nID, coords[cID], pos, n.tID, n.off);
		}
	S.gmask.reserve(S.stencil.size());  Ind<D> ml3(1);  for(int i=1; i<D; i++) ml3[i] = ml3[i-1]*3; 
	for(const Ind<D> &p: S.stencil)  S.gmask.push_back(ind(-1)<=p && p<=ind(1)? gmask[(p+ind(1))*ml3]: 0);
	return stencils.size()-1;
}
