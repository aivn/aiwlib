template <typename T, int D, int R, bool cell_based> uint64_t
TiledAdaptiveMesh<T, D, R, cell_based>::Item::out_border_mask() const {  // выход шаблона за границу сетки
	uint64_t m = 0;  for(int cID=0; cID<stencil_sz; cID++) m |= bool(storage->bmask[snodes[cID].tID]&tile->bmask)<<cID;  
	return m;
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> Vecf<D>                // смещение к соседу, к которому было последнее обращение через [],
TiledAdaptiveMesh<T, D, R, cell_based>::Item::delta_r(int subcell) const {  // subcell задает элемент в чанке если srank=rank()+1
	const Ind<D> &dp = storage->stencils[current_stID].stencil[current_cID];
	if(srank==rank()) return dp&storage->steps[rank()];
	// if(srank<rank()) return ((storage->coords[off]+dp+ind(1<<R))/2*2-ind(1<<R)-storage->coords[off]+vecf(.5f))&storage->steps[rank()];
	if(srank<rank()) return (((storage->coords[off]+dp)*.5f).floor()*2-storage->coords[off]+vecf(.5f))&storage->steps[rank()];
	return (dp*2+storage->coords[subcell]-vecf(.5f))&storage->steps[rank()+1];  // протестировано
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> uint64_t
TiledAdaptiveMesh<T, D, R, cell_based>::BItem::bmask(bool out_border) const {  // возвращает маску с информацией о расположении соседей по шаблону за границей сетки
	if(out_border) return this->out_border_mask();
	uint64_t m = 0;
	for(int cID=0; cID<stencil_sz; cID++){ stencil_node_t sn = snodes[cID];  const tile_t* t = cube[sn.tID];  m |= uint64_t(!t || !t->usage[sn.off])<<cID;	}
	return m;
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> const T*
TiledAdaptiveMesh<T, D, R, cell_based>::BItem::operator [] (int cID) noexcept {  // доступ к элементу шаблона номер cID, если такого узла нет возвращает nullptr
	stencil_node_t sn = snodes[cID];  const tile_t* t = cube[sn.tID];  current_cID = cID;
	if(t && t->usage[sn.off]){ stile = t; soff = sn.off;  srank = t->rank();  return t->data+sn.off; }  // штатное поведение, целевой элемент есть
	if(cell_based || (sn.off&dbits)==0){  // смотрим только на один ранг вверх --- для cell_based всегда, для node_based только если попадаем в узел крупной сетки
		if(t && t->parent){  // есть соседний тайл и тайл над ним, в случае разрыва все сломается?
			int f = storage->up_off(t->toff, sn.off);
			if(t->parent->usage[f]){ stile = t->parent; soff = f;  srank = t->rank()-1; return t->parent->data+f; }
		}
		if(!t){  // соседнего тайла нет, но все же может быть тайл сверху
			auto I = storage->forest.find(storage->up_toff(toff_cube[sn.tID]));  // вот это дорогая операция, создать в item битовую маску с указанием есть ли кто то сверху?
			if(I!=storage->forest.end()){
				int f = storage->up_off(toff_cube[sn.tID], sn.off);
				if(I->second.usage[f]){ stile = &I->second; soff = f;  srank = tile->rank()-1; return I->second.data+f; }
			}
		}
	}
	// смотрим только на один ранг вниз
	int f = sn.off;  uint64_t tf = toff_cube[sn.tID];
	if(storage->inc_rank(tf, f)){
		auto I = storage->forest.find(tf);
		if(I!=storage->forest.end() && I->second.usage[f]){
			srank = tile->rank()+1;
			// this->smask = 0;   for(int i=0; i<(1<<D); i++) this->smask |= uint64_t(I->second.usage[f+i])<<i;
			this->smask = I->second.usage.get_chunk(D, f);
			this->gmask.data = this->smask&storage->stencils[this->current_stID].gmask[cID];
			stile = &I->second; soff = f; 
			return I->second.data+f;
		}
	}
	srank = -1; stile = nullptr; soff = -1; return nullptr;
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> template <typename Func> auto
TiledAdaptiveMesh<T, D, R, cell_based>::Item::operator ()(Func func) const {  // вызывает func(const T& cell, auto &item) для последнего элемента в который попали через []
	BItem item;  item.storage = storage;  item.parent_item = (Item*)this;
	if(stile){ storage->config_item(item, (tile_t*)stile);  item.off = soff; }
	else{ stencil_node_t sn = snodes[current_cID]; storage->config_item(item, cube[sn.tID]);  item.off = sn.off; }
	if(!item.tile || !item.tile->usage[item.off]){
		WMSG("call () for not active element ", stile, soff, tile->toff, off, rank(), current_stID, current_cID, item.tile, item.off, item.tile->usage[item.off]);
		abort();
	}
	return func(item.tile->data[item.off], item);
}
