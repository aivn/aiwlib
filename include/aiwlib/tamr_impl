//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> template <typename Func> void
TiledAdaptiveMesh<T, D, R, cell_based>::rebuild(Func func, typename TiledAdaptiveMesh<T, D, R, cell_based>::BItem* items, int items_sz){  // завершает перестроение сетки
	// WMSG("rebuild");
	fix_mode = true;   double tpf1 = omp_get_wtime(), tpf2;  BItem& item = items[0];
	for(auto &I: item.patches) if(!I.second.tile) I.second.tile = &add_tile(toff2tpos(I.first), I.first&31);  // создаем новые тайлы по необходимости
	std::vector<std::tuple<uint64_t, int, CreatorInfo> > join_table;  
	for(auto &I: item.patches){  //<<< сейчас тут самое узкое место перестроения, кроме гало?
		item.tile = I.second.tile;  item.pself = &I.second; 
		for(auto J=I.second.table.begin(); J!=I.second.table.end();){
			if(!J->second.join()){ I.second.tile->usage.set(J->first, J->second.add()); ++J; }
			else {
				if((cell_based || (J->first&dbits)==0) && item.fix_join(J))  join_table.emplace_back(I.first, J->first, J->second);  
				I.second.table.erase(J++);  // чистим таблицу изменений от элементов отмеченных для удаления
			}
		}
	}  // теперь все usage в тайлах обновлены за счет split
	for(const auto &I: join_table){  // создаем элементы добавленные через join
		uint64_t tf = std::get<0>(I);  int f = std::get<1>(I);  dec_rank(tf, f);
		if(!item.tile || item.tile->toff!=tf) item.tile = &add_tile(toff2tpos(tf), tf&31);		
		item.patch_self().table[f] = std::get<2>(I);  item.tile->usage.set(f);
	}  // теперь вообще все usage в тайлах обновлены
	tpf2 = omp_get_wtime(); profile.runtime[TAMR_pf::t_alloc] = tpf2-tpf1;  tpf1 = tpf2;
	//--------------------------------------------------------------------------
	if(rebuild_stID>=0){  // начало проверки скачка ранга разбиения
		if(rebuild_stID>=int(stencils.size())){ WMSG("incorrect ", rebuild_stID, ">=", stencils.size());  exit(1); }
		std::unordered_map<uint64_t, grad_patch_t> table1, table2;  bool go = false;  // struct grad_patch_t{ Item::patch_t *ipp; std::set<int> table; };
		for(auto &I: item.patches){  // предварительная набивка table1 для запуска метода марша
			auto &J = table1[I.first];  J.ipp = &I.second;  
			for(auto& p: I.second.table) if(p.second.add()){ J.table.set(p.first); J.join.set(p.first, p.second.join()); go = true; }  // только добавленные элементы
		}
		std::unordered_map<uint64_t, BitMask<1<<R*D> > ubm_table;  // таблица с usage объединяющих три ранга S, S+1, S-1, заполняется ленивым образом
		const auto &stencil = stencils[rebuild_stID].nodes;  stencil_sz = stencil.size()>>R*D; 
		while(go){  // начало метода марша
			go = false;
			for(auto &I: table1){  // начало прохода по table1 с добавлением изменений в table2
				BitMask<1<<R*D>* ubm_cube[calc_3pow<D>::x];  for(int i=0; i<calc_3pow<D>::x; i++) ubm_cube[i] = nullptr;
				tile_t *tile = I.second.ipp->tile;
				for(int off: I.second.table){  // начало прохода по тайлу 
					const stencil_node_t *snodes = stencil.data()+stencil_sz*off;  bool is_join = I.second.join[off];
					uint64_t toff_up2 = toff; int off_up2 = off;  if(!is_join && (toff&31)>1){ dec_rank(toff_up2, off_up2); dec_rank(toff_up2, off_up2); }
					for(int cID=0; cID<item.stencil_sz; cID++){  // начало цикла по шаблону
						stencil_node_t sn = snodes[cID];  if(bmask[sn.tID]&tile->bmask) continue;  // попали за границу сетки, надо регулировать битовой маской periodic?
						if(!ubm_cube[sn.tID]){  // ищем необходимую битовую маску
							uint64_t toff2 = tpos2toff(toff2tpos(tile->toff, tile->rank())+cube3Xtpos[sn.tID]);  auto U = ubm_table.find(toff2);
							if(U==ubm_table.end()){ ubm_cube[sn.tID] = &ubm_table[toff2]; mk3layer_usage(*ubm_cube[sn.tID], toff2); }  // формируем необходимую битовую маску
							else ubm_cube[sn.tID] = &U->second;
						}  // конец поиска битовой маски
						if(is_join){ if(!ubm_cube[sn.tID]->get(sn.off)){  // для созданного через join элемента нет соседа, отменяем join
								I.second.ipp->table.erase(off);  I.second.ipp->tile->usage.set(off, false);
								uint64_t toff2 = I.first;  int off2 = off; dec_rank(toff2, off2);  forest[toff2].usage.set_chunk(D, off2);
								patch_t &P = item.patches[toff2];  auto J = P.table.find(off2); for(int i=0; i<(1<<D); i++) P.table.erase(J++);
								break;
							}
						} else if(!ubm_cube[sn.tID]->get(sn.off)){  // для созданного через split узла нет соседа, отмечаем соседа для разбиения
							uint64_t toff2 = tpos2toff(toff2tpos(toff)+cube3Xtpos[sn.tID]);  int off2 = sn.off;  // ПГУ? Оптимизация?
							if(dec_rank(toff2, off2) && dec_rank(toff2, off2)) split_item(toff2, off2, item, table2); 
						} else if((I.first&31)>1){  // есть сосед для созданного через split узла, но нужна проверка соседа на два уровня выше
							uint64_t toff2 = tpos2toff(toff2tpos(toff_up2)+cube3Xtpos[sn.tID]);  auto J = forest.find(toff2);  // ПГУ? Надо как то разрешать границы? Оптимизация?
							if(J!=forest.end() && J->second.usage[sn.off]) split_item(toff2, sn.off, item, table2);  // этого соседа надо разбить? Только для симметричных шаблонов?
						} 
					}  // конец цикла по шаблону 					
				}  // конец прохода по тайлу
			}  // конец прохода по table1
			table1.swap(table2); table2.clear();
		}  // конец метода марша		
	}  // конец проверки скачка ранга разбиения
	tpf2 = omp_get_wtime(); profile.runtime[TAMR_pf::t_grad] = tpf2-tpf1;  tpf1 = tpf2;
	//--------------------------------------------------------------------------
	if(ghost_stID>=0){  // начало автоматического формирование гало из ghost-ячеек
		if(ghost_stID>=int(stencils.size())){ WMSG("incorrect ", ghost_stID, ">=", stencils.size());  exit(1); }
		std::vector<std::unordered_map<uint64_t, std::vector<int>>> htables(items_sz);  // tID:{offs} для элементов относящихся к гало, это патчи для tile_t::usage
		std::vector<typename Item::patch_t*> patches(item.patches.size()); int patches_sz = 0;  for(auto &I: item.patches) patches[patches_sz++] = &I.second;
#pragma omp parallel for if(items_sz>1)
		for(int ip=0; ip<patches_sz; ip++){
			int thID = omp_get_thread_num();  BItem &itm = items[thID];  auto &htable = htables[thID];  
			typename Item::patch_t &P = *(patches[ip]);  config_item(itm, P.tile); 
			for(auto &J: P.table){
				itm.off = J.first;  itm.stencil(ghost_stID);
				if(J.second.mode==2){  // элемент отмечен для создания через join
					for(int cID=0; cID<itm.stencil_sz; cID++){
						stencil_node_t sn = itm.snodes[cID];
						if(bmask[sn.tID]&itm.tile->bmask) continue;  // попали за границу сетки, вообще это надо регулировать битовой маской periodic? 
						tile_t* t = itm.cube[sn.tID];  uint64_t tf = itm.toff_cube[sn.tID];
						if((!t || !t->usage[sn.off]) && check_children(tf, sn.off, t))  // нет соседа на том же ранге и у соседа есть какие то ячейки снизу - создаем соседа
							htable[P.toff].push_back(sn.off);
					}
				} else if(J.second.mode==1 && check_children(P.toff, J.first, P.tile)){  // элемент отмечен для удаления
					for(int cID=0; cID<itm.stencil_sz; cID++){
						stencil_node_t sn = itm.snodes[cID];
						if(bmask[sn.tID]&itm.tile->bmask) continue;  // попали за границу сетки, вообще это надо регулировать битовой маской periodic? 
						tile_t* t = itm.cube[sn.tID];  
						if(t && t->usage[sn.off]){ htable[P.toff].push_back(J.first);  break; } // есть сосед на том же ранге, надо восстановить элемент и все
					}
				}
			}
		}
		for(int thID=1; thID<items_sz; thID++)  for(auto &H: htables[thID]){
				std::vector<int> &dst = htables[0][H.first];
				if(dst.size()==0) dst.swap(H.second);	else for(int x: H.second) dst.push_back(x);
			}
		for(auto &H: htables[0]){
			tile_t *tile = &add_tile(toff2tpos(H.first), H.first&31);  typename Item::patch_t *patch = item.add_patch(H.first, tile);			
			for(int f: H.second) if(!tile->usage[f]){
					CreatorInfo &cr = patch->table[f];  cr.mode = 2;  cr.rank = (H.first&31)+1;
					tile->usage.set(f);  add_ghost(tile, f);  profile.count[TAMR_pf::n_ghost]++;
				}
		}
	}  // конец автоматического формирования гало из ghost-ячеек
	tpf2 = omp_get_wtime(); profile.runtime[TAMR_pf::t_ghost] = tpf2-tpf1;  tpf1 = tpf2;
	//--------------------------------------------------------------------------

	std::vector<typename Item::patch_t*> patches(item.patches.size()); int patches_sz = 0;  uint64_t cell_count = 0;
	for(auto &I: item.patches){ patches[patches_sz++] = &I.second;  I.second.tile->usage.swap(I.second.usage); } // восстанавливаем старые маски
#pragma omp parallel for reduction(+:cell_count) if (items_sz>1)
	for(int ip=0; ip<patches_sz; ip++){
		typename Item::patch_t &P = *(patches[ip]);
		if(!P.usage.size()) continue;  // в итоге активных элементов не осталось, но удалять тайл пока рано - в него м.б. доступ со стороны
		BItem &itm = items[omp_get_thread_num()];  config_item(itm, P.tile);  if(!P.usage.size()) itm.tile->groups = 0;
		for(auto &J: P.table)
			if(J.second.add() && !P.tile->usage[J.first]){
				itm.cinfo = J.second; itm.prepare(J.first); 
				func(itm.tile->data[J.first], itm);  cell_count++;
				itm.tile->groups |= itm.groups;
			}		
	}
	tpf2 = omp_get_wtime(); profile.runtime[TAMR_pf::t_add] = tpf2-tpf1;  tpf1 = tpf2;  profile.count[TAMR_pf::n_add] = cell_count;

	for(auto &I: item.patches){   // накатываем новые маски, удаляем пустые тайлы
		if(!I.second.usage.size() || !I.second.tile->groups) del_tile(I.second.tile->tID); 
		else{
			tile_t *tile = I.second.tile; tile->usage = I.second.usage;
			if(tile->ghost_tID>=0){  // обрабатываем ghost usage
				ghost_tiles[tile->ghost_tID].usage &= tile->usage;  int ghtID = tile->ghost_tID;
				if(!ghost_tiles[ghtID].usage){  // если ghost ячеек в тайле больше нет удаляем тайл из ghost_tiles
					if(ghtID<int(ghost_tiles.size())-1){ ghost_tiles.back().tile->ghost_tID = ghtID; ghost_tiles[ghtID] = ghost_tiles.back(); }
					ghost_tiles.pop_back(); tile->ghost_tID = -1;
				}
			}
		}
	}
	profile.runtime[TAMR_pf::t_del] = omp_get_wtime()-tpf1;
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> bool
TiledAdaptiveMesh<T, D, R, cell_based>::config_item(typename TiledAdaptiveMesh<T, D, R, cell_based>::BItem& item,
													typename TiledAdaptiveMesh<T, D, R, cell_based>::tile_t* tile){
	double t_start = omp_get_wtime(); 
	item.step = step/(1<<tile->rank());	 item.bmin = bmin+(toff2tpos(tile->toff)*(1<<R)&item.step);  if(cell_based) item.bmin += item.step*.5f;
	item.cube[calc_3pow<D>::x/2] = item.tile = tile;  item.toff_cube[calc_3pow<D>::x/2] = tile->toff;   item.srank = tile->rank(); // для Item[]
	item.tpos = toff2tpos(tile->toff);  int rank = tile->rank();  bool easy = tile->usage.all();  item.join_cell_chunk = -1;
	for(int cid=0; cid<calc_3pow<D>::x; cid++){  // это можно оптимизировать?
		if(cid==calc_3pow<D>::x/2) continue;
		Ind<D> tpos = item.tpos;  int ii = cid;
		for(int i=0; i<D; i++){ int sz = tbox[i]<<rank; tpos[i] = (tpos[i]+ii%3-1+sz)%sz; ii /= 3; }  // ПГУ
		item.toff_cube[cid] = tpos2toff(tpos, tile->rank()); 
		auto I = forest.find(item.toff_cube[cid]); item.cube[cid] = I==forest.end()? nullptr: &(I->second);
		if(easy && (!item.cube[cid] || !item.cube[cid]->usage.all())) easy = false;
	}
	item.stile = nullptr;  item.soff = -1;
	item.iconf_count++;  item.iconf_runtime += omp_get_wtime()-t_start;
	return !easy;
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> void TiledAdaptiveMesh<T, D, R, cell_based>::Item::prepare(int f) noexcept {
	off = f;  groups = tile->groups;
	// if(cell_based && (off&((1<<D)-1))==0) join_cell_counter = 0;
	if(join_cell_chunk!=(off>>D)){ join_cell_counter = 0; join_cell_chunk = off>>D; }
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> template <typename Func> void
TiledAdaptiveMesh<T, D, R, cell_based>::for_each(Func func, uint32_t rmask, uint64_t groups){
	double t_start = omp_get_wtime();  profile.count = Vec<1, uint64_t>();  profile.runtime = Vec<1>();
	int Nth = threads, Nth_old = omp_get_max_threads();  if(threads<=0) Nth = Nth_old; else omp_set_num_threads(threads); 
	std::vector<BItem> items(Nth); for(BItem &item: items) item.storage = this;
	std::vector<tile_t*>  ttable, *pttable = &tiles;
	if(rmask!=~0){
		ttable.reserve(tiles.size()); pttable = &ttable;
		for(int r=rank_lim; r>=0; r--) if(rmask&(1<<r) && rtiles[r].size()) for(tile_t* t: rtiles[r]) ttable.push_back(t);
	}
	fix_mode = false;  int tiles_sz = pttable->size();  uint64_t tot_count = 0, tot_tiles = 0;
#pragma omp parallel for reduction(+:tot_count,tot_tiles) if(Nth>1)
	for(int tID=0; tID<tiles_sz; tID++){
		//	for(auto &I: forest){
		tile_t *tile = (*pttable)[tID]; if(!((1<<tile->rank())&rmask) || !(tile->groups&groups)) continue;
		BItem &item = items[omp_get_thread_num()];  tot_tiles++;
		bool is_bound = config_item(item, tile);  uint64_t new_groups = 0;
		if(is_bound) for(int f: tile->usage){  item.prepare(f); func(tile->data[f], item);         new_groups |= item.groups;    tot_count++; }
		else{ for(int f=0; f<(1<<R*D); f++){    item.prepare(f); func(tile->data[f], (Item&)item); new_groups |= item.groups;  } tot_count += 1<<R*D; }
		tile->groups = new_groups;
	}
	double t_mid = omp_get_wtime();  profile.runtime[TAMR_pf::t_main] = t_mid - t_start;
	profile.count[TAMR_pf::n_main] = tot_count; profile.count[TAMR_pf::n_tmain] = tot_tiles;
	for(int it=1; it<Nth; it++){  // сборка всех патчей в items[0]
		for(auto &I: items[it].patches){
			typename Item::patch_t &dst = items[0].patches[I.first];
			dst.toff = I.second.toff;  dst.tile = I.second.tile;
			if(dst.table.size()==0) dst.table.swap(I.second.table);
			else for(auto J: I.second.table){ CreatorInfo &cr = dst.table[J.first]; if(cr.mode==1) cr = J.second; }
		}
	}
	profile.runtime[TAMR_pf::t_join] = omp_get_wtime()-t_mid;
	if(items[0].patches.size()) rebuild(func, &items[0], Nth);
	if(threads>0) omp_set_num_threads(Nth_old);
	for(BItem& item: items){ profile.count[TAMR_pf::n_iconf] += item.iconf_count;  profile.runtime[TAMR_pf::t_iconf] += item.iconf_runtime; }
	profile.runtime[TAMR_pf::t_rebuild] = omp_get_wtime()-t_mid;
}
//------------------------------------------------------------------------------
template <typename T, int D, int R, bool cell_based> template <typename Func> void
TiledAdaptiveMesh<T, D, R, cell_based>::for_ghosts(Func func, uint32_t rmask, uint64_t groups){
	double t_start = omp_get_wtime();  profile.count = Vec<1, uint64_t>();  profile.runtime = Vec<1>();
	int Nth = threads, Nth_old = omp_get_max_threads();  if(threads<=0) Nth = Nth_old; else omp_set_num_threads(threads); 
	std::vector<BItem> items(Nth); for(BItem &item: items) item.storage = this;
	fix_mode = true;  int tiles_sz = ghost_tiles.size();  uint64_t tot_count = 0, tot_tiles = 0;
#pragma omp parallel for reduction(+:tot_count,tot_tiles) if(Nth>1)
	for(int tID=0; tID<tiles_sz; tID++){
		tile_t *tile = ghost_tiles[tID].tile; if(!((1<<tile->rank())&rmask) || !(tile->groups&groups)) continue;
		BItem &item = items[omp_get_thread_num()];  tot_tiles++; 
		for(int f: ghost_tiles[tID].usage){  item.prepare(f); func(tile->data[f], item); tot_count++; }
	}
	profile.runtime[TAMR_pf::t_main] = omp_get_wtime() - t_start; profile.count[TAMR_pf::n_main] = tot_count; profile.count[TAMR_pf::n_tmain] = tot_tiles;
	if(threads>0) omp_set_num_threads(Nth_old);
}
